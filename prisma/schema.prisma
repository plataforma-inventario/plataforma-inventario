// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PerfilAcesso {
  AUDITOR // admin: acesso total, unico que lanca dados
  DIRETORIA // acesso total, somente leitura
  GERENTE_VAREJO
  GERENTE_REVENDA
  LOGISTICA
}

enum TipoLoja {
  VAREJO
  REVENDA
  LOGISTICA // ex: Centro de Distribuicao
}

enum TipoUnidade {
  MATRIZ
  FILIAL
}

enum CicloContagem {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
}

enum TipoInventario {
  CICLICO // cobre so os itens do setor/curva do ciclo (padrao)
  COMPLETO // conta a loja inteira, fora do calendario normal - exige motivo
}

// Motivos conhecidos de inventario completo (item 3.0). "OUTRO" cobre casos
// nao previstos - motivoDetalhe carrega o texto livre nesse caso.
enum MotivoInventarioCompleto {
  SUSPEITA_ROUBO
  POS_NATAL_JANEIRO
  OUTRO
}

enum StatusCiclo {
  ABERTO // lancamento em andamento (uploads incompletos)
  FECHADO // cruzamento de divergencias ja rodou, entra no historico
}

// Um slot por categoria no ciclo de lancamento (item 2.1). Ajuste entra como
// categoria unica (nao separada em entrada/saida) porque o relatorio real da
// loja ja traz os dois tipos juntos num so arquivo (coluna "Tipo Ajuste"
// dentro do PDF) - forcar dois uploads geraria o mesmo arquivo duas vezes e
// esbarraria no bloqueio de duplicidade do item 10.
enum CategoriaArquivo {
  INVENTARIO
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
  AJUSTE
  REQUISICAO
  FATURAMENTO
}

// Resultado do parsing de um ArquivoImportado (item 10: "sugerir/validar um
// padrao de colunas"). AVISO = leu o arquivo mas achou algo estranho (linha
// que nao bateu o formato esperado, motivo de requisicao desconhecido etc) -
// nao impede o lancamento, mas fica visivel na tela de conferencia.
enum StatusParsing {
  PENDENTE
  OK
  AVISO
  ERRO
}

enum DirecaoMovimento {
  ENTRADA
  SAIDA
}

// ---------------------------------------------------------------------------
// Hierarquia organizacional: Grupo (CNPJ) -> Regiao -> Loja (PDV)
// Regiao e independente de Grupo (uma regiao agrupa lojas de grupos
// diferentes) para permitir relatorios como "todas as lojas de Dracena".
// ---------------------------------------------------------------------------

model Grupo {
  id          String  @id @default(cuid())
  nome        String  @unique // ex: "CP F Nunes", "CP SH Nunes"
  razaoSocial String?

  lojas Loja[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Regiao {
  id   String @id @default(cuid())
  nome String @unique // ex: "Prudente", "Dracena", "Venceslau"

  lojas Loja[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Loja {
  id             String         @id @default(cuid())
  pdv            Int            @unique // codigo BPCS
  nome           String
  cnpj           String         @unique
  tipoUnidade    TipoUnidade
  tipoLoja       TipoLoja
  cicloContagem  CicloContagem?
  // Subgrupo do calendário fixo de auditoria (ex: "B1", "B2", "T1"..."T3") -
  // define em quais meses exatos essa loja e contada dentro do seu ciclo
  // (bimestral/trimestral). Null para mensal (conta todo mes) ou quando nao
  // definido. Ver docs/BRIEFING.md para a tabela de meses por subgrupo.
  grupoAuditoria String?
  ativa          Boolean        @default(true)

  grupoId String
  grupo   Grupo  @relation(fields: [grupoId], references: [id])

  regiaoId String?
  regiao   Regiao? @relation(fields: [regiaoId], references: [id])

  gerentes LojaGerente[]
  ciclos   Ciclo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grupoId])
  @@index([regiaoId])
}

// ---------------------------------------------------------------------------
// Usuarios e controle de acesso
// ---------------------------------------------------------------------------

model User {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  senhaHash String
  perfil    PerfilAcesso
  ativo     Boolean      @default(true)

  lojasGeridas     LojaGerente[]
  ciclosCriados    Ciclo[]
  arquivosEnviados ArquivoImportado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Vinculo N:N entre gerentes e as lojas sob sua gestao (item 1: controla
// automaticamente o filtro de acesso por loja de cada gerente).
model LojaGerente {
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@id([lojaId, userId])
}

// ---------------------------------------------------------------------------
// Fluxo de lancamento (item 2.1): cada Ciclo cobre o periodo entre o
// inventario anterior de uma loja e o atual. Fecha quando os 6 uploads
// necessarios estao completos e o cruzamento de divergencias roda em cima.
// ---------------------------------------------------------------------------

model Ciclo {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  // Detectado automaticamente a partir do dataFim do ciclo FECHADO anterior
  // dessa loja (ou da data de cadastro da loja, se for o primeiro ciclo).
  dataInicio DateTime
  dataFim    DateTime

  tipoInventario TipoInventario
  motivoCompleto MotivoInventarioCompleto?
  motivoDetalhe  String?

  observacao String? // item 10.3: contexto livre (ex: "loja em reforma")

  status StatusCiclo @default(ABERTO)

  arquivos ArquivoImportado[]

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
}

model ArquivoImportado {
  id      String @id @default(cuid())
  cicloId String
  ciclo   Ciclo  @relation(fields: [cicloId], references: [id])

  categoria CategoriaArquivo

  nomeArquivo  String
  tipoMime     String
  hashConteudo String // sha256 do conteudo - bloqueia reimportacao do mesmo arquivo (item 10)
  tamanhoBytes Int
  conteudo     Bytes // arquivo original guardado direto no Postgres (ver feedback_stack_proposal na memoria: sem provedor externo de storage, arquivos sao pequenos)

  uploadedByUserId String
  uploadedBy       User   @relation(fields: [uploadedByUserId], references: [id])

  // Preenchido pelo parser logo apos o upload (item 10 / etapa de parsing).
  statusParsing StatusParsing @default(PENDENTE)
  resumoParsing String? // ex: "128 linhas, 2 avisos"
  avisosParsing String[]      @default([])

  createdAt DateTime @default(now())

  itensInventario    ItemInventario[]
  itensTransferencia ItemTransferencia[]
  itensAjuste        ItemAjuste[]
  itensRequisicao    ItemRequisicao[]
  faturamento        Faturamento?

  @@unique([cicloId, categoria]) // um arquivo por categoria dentro do mesmo ciclo
  @@unique([hashConteudo]) // mesmo arquivo (byte a byte) nunca pode ser reimportado, em nenhum ciclo
}

// ---------------------------------------------------------------------------
// Dados estruturados extraidos de cada arquivo (etapa de parsing). Cada
// modelo espelha o formato real dos relatorios que a loja exporta do
// sistema (nomes de campo em portugues combinando com o relatorio de
// origem, para facilitar conferencia cruzada com o arquivo original).
// ---------------------------------------------------------------------------

model ItemInventario {
  id        String           @id @default(cuid())
  arquivoId String
  arquivo   ArquivoImportado @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  codigoProduto     String
  descricaoProduto  String
  unidade           String
  quantidadeSistema Decimal @db.Decimal(14, 3) // coluna "Congelado" do relatorio: saldo antes da contagem
  quantidadeContada Decimal @db.Decimal(14, 3) // coluna "Digitado"
  ajuste            Decimal @db.Decimal(14, 3) // diferenca (contada - sistema)
  custoUnitario     Decimal @db.Decimal(14, 2)
  valorAjuste       Decimal @db.Decimal(14, 2)
  valorEstoque      Decimal @db.Decimal(14, 2)

  lojaOrigemTexto String // texto cru da coluna "Loja" do relatorio (ex: "11101 - PRUDENSHOPPING")
  local           String?
  tipoArquivo     TipoInventario // valor da coluna "Tipo" do proprio relatorio (conferir contra o Ciclo)

  createdAt DateTime @default(now())

  @@index([arquivoId])
  @@index([codigoProduto])
}

model ItemTransferencia {
  id        String           @id @default(cuid())
  arquivoId String
  arquivo   ArquivoImportado @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  direcao DirecaoMovimento // ENTRADA (relatorio de compra) ou SAIDA (relatorio de venda)

  numeroDocumento   String
  dataEmissao       DateTime
  contraparteCodigo String // "Codigo do Fornecedor" (entrada) ou identificador do cliente (saida) - geralmente a outra loja
  contraparteNome   String

  codigoProduto    String
  descricaoProduto String
  unidade          String
  quantidade       Decimal @db.Decimal(14, 3)
  valorUnitario    Decimal @db.Decimal(14, 2)
  valorTotalItem   Decimal @db.Decimal(14, 2)
  cfop             String

  createdAt DateTime @default(now())

  @@index([arquivoId])
  @@index([codigoProduto])
}

model ItemAjuste {
  id        String           @id @default(cuid())
  arquivoId String
  arquivo   ArquivoImportado @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  direcao DirecaoMovimento // derivado da coluna "Tipo Ajuste" (1 = entrada, 2 = saida) do PDF

  dataMovimento    DateTime
  codigoProduto    String
  descricaoProduto String
  quantidade       Decimal  @db.Decimal(14, 3) // sempre positiva - a direcao ja diz o sentido
  custoUnitario    Decimal  @db.Decimal(14, 2)
  valorTotalCusto  Decimal  @db.Decimal(14, 2)
  funcionario      String?
  observacao       String? // texto livre do PDF - muitas vezes documenta transferencia entre lojas (util pro item 5.1)

  createdAt DateTime @default(now())

  @@index([arquivoId])
  @@index([codigoProduto])
}

model ItemRequisicao {
  id        String           @id @default(cuid())
  arquivoId String
  arquivo   ArquivoImportado @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  numero             String
  setor              String?
  solicitante        String?
  codigoProduto      String
  descricaoProduto   String
  unidade            String
  quantidadeAtendida Decimal  @db.Decimal(14, 3)
  custoTotal         Decimal  @db.Decimal(14, 2)
  dataRequisicao     DateTime
  motivoCodigo       String // texto cru da coluna "Motivo" (ex: "1 - DEMONSTRADORES")
  observacao         String?

  createdAt DateTime @default(now())

  @@index([arquivoId])
  @@index([codigoProduto])
}

// Uma linha por ArquivoImportado (relatorio de faturamento ja vem
// pre-resumido por loja/periodo, sem detalhe por item).
model Faturamento {
  id        String           @id @default(cuid())
  arquivoId String           @unique
  arquivo   ArquivoImportado @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  receitaLiquida Decimal @db.Decimal(14, 2)
  periodoTexto   String // ex: "AGOSTO", conforme o relatorio de origem

  createdAt DateTime @default(now())
}
